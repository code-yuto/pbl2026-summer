APP_NAME=Drought Monitoring API
APP_VERSION=0.1.0
DEBUG=true

FARM_LATITUDE=21.0278
FARM_LONGITUDE=105.8342
WEATHER_TIMEZONE=auto
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EXTERNAL_API_TIMEOUT_SECONDS=20

SOIL_CRITICAL_THRESHOLD=20
SOIL_HIGH_THRESHOLD=25
SOIL_MEDIUM_THRESHOLD=40

WATER_CRITICAL_THRESHOLD=5
WATER_HIGH_THRESHOLD=8
WATER_MEDIUM_THRESHOLD=12

SERIAL_DEVICE_ID=ESP32_SERIAL_01
SOIL_SENSOR_DRY_RAW=2800
SOIL_SENSOR_WET_RAW=1500
WATER_SENSOR_EMPTY_RAW=0
WATER_SENSOR_FULL_RAW=1500

ALLOWED_ORIGINS=http://localhost:8501

BACKEND_URL=http://localhost:8000
